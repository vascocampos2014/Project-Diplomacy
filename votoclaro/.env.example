# Copy to .env.local (git-ignored) for local development.

# URL of the RAG backend (backend/, POST /ask). Without it the Perguntar tab
# shows "Disponível em breve". Expo embeds EXPO_PUBLIC_* values in the bundle,
# so never put secrets here: the Groq key stays on the backend only.
# When this points to a deployed backend, also add that URL to connect-src in
# the Content-Security-Policy in vercel.json.
EXPO_PUBLIC_RAG_API_URL=http://localhost:8000
