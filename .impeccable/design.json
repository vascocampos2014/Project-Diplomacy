  "components": [
    {
      "name": "Ballot Slip",
      "kind": "card",
      "refersTo": "slip",
      "description": "The feed's unit: a vote drawn as a ballot slip with title, meta, stamp, tally, seat bar and three ballot rows.",
      "html": "<a class=\"ds-slip\" href=\"#\"><div class=\"ds-slip-head\"><div class=\"ds-slip-title\">Alteração ao regime do arrendamento urbano</div><div class=\"ds-slip-meta\"><span>PJL 123/XVII</span><span>Habitação</span><span>28 Out</span></div><div class=\"ds-slip-res\"><span class=\"ds-stamp ds-stamp-ok\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\"><path fill=\"currentColor\" d=\"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg>Aprovada</span><span class=\"ds-tally\"><b style=\"color:#15803D\">91</b> a favor <b style=\"color:#B91C1C\">79</b> contra <b style=\"color:#B45309\">60</b> abstenção</span></div><div class=\"ds-seatbar\"><i style=\"flex:91;background:#15803D\"></i><i style=\"flex:79;background:#B91C1C\"></i><i style=\"flex:60;background:#B45309\"></i></div></div><div class=\"ds-slip-rows\"><div class=\"ds-row\"><span class=\"ds-xbox\"><svg viewBox=\"0 0 18 18\" width=\"18\" height=\"18\"><path d=\"M5 5L13 13M13 5L5 13\" stroke=\"#120A8F\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg></span><span class=\"ds-rowlabel\">A favor</span><span class=\"ds-parties\"><i class=\"ds-dot\" style=\"background:#F0385C\"></i>PS <i class=\"ds-dot\" style=\"background:#7C3AED\"></i>L</span></div><div class=\"ds-row\"><span class=\"ds-xbox\"><svg viewBox=\"0 0 18 18\" width=\"18\" height=\"18\"><path d=\"M5 5L13 13M13 5L5 13\" stroke=\"#120A8F\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg></span><span class=\"ds-rowlabel\">Contra</span><span class=\"ds-parties\"><i class=\"ds-dot\" style=\"background:#F97316\"></i>PSD</span></div><div class=\"ds-row\"><span class=\"ds-xbox\"></span><span class=\"ds-rowlabel\" style=\"color:#585D64\">Abstenção</span><span class=\"ds-parties\" style=\"color:#585D64;font-weight:400\">Nenhum partido</span></div></div></a>",
      "css": ".ds-slip{display:block;max-width:420px;background:#FFFFFF;border:1.5px solid #232323;border-radius:3px;color:#232323;text-decoration:none;font-family:'Public Sans',system-ui,sans-serif;transition:border-color 200ms cubic-bezier(0.16,1,0.3,1),background-color 200ms cubic-bezier(0.16,1,0.3,1);}.ds-slip:hover,.ds-slip:focus-visible{border-color:#120A8F}.ds-slip:focus-visible{outline:2px solid #449DD1;outline-offset:2px}.ds-slip-head{padding:16px;display:flex;flex-direction:column;gap:8px}.ds-slip-title{font-size:17px;font-weight:600;line-height:23px;letter-spacing:-0.15px}.ds-slip-meta{display:flex;gap:12px;font-size:13px;color:#585D64}.ds-slip-res{display:flex;align-items:center;gap:12px;flex-wrap:wrap}.ds-stamp{display:inline-flex;gap:4px;padding:3px 8px 3px 6px;border:1.5px solid;border-radius:2px;font-size:12px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase}.ds-stamp-ok{background:#120A8F;border-color:#120A8F;color:#FFFFFF}.ds-tally{font-size:13px;color:#585D64}.ds-tally b{font-size:16px;font-variant-numeric:tabular-nums;margin:0 2px 0 8px}.ds-seatbar{display:flex;gap:2px;height:6px;background:#DADDE2}.ds-slip-rows{border-top:1px solid #DADDE2;padding:0 16px}.ds-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-top:0.5px solid #DADDE2}.ds-row:first-child{border-top:0}.ds-xbox{display:inline-flex;width:18px;height:18px;border:1.5px solid #232323;border-radius:2px;box-sizing:border-box;align-items:center;justify-content:center;overflow:hidden}.ds-xbox svg{width:15px;height:15px}.ds-rowlabel{width:76px;font-size:14px;font-weight:600}.ds-parties{font-size:13px;font-weight:600;display:flex;align-items:center;gap:5px}.ds-dot{display:inline-block;width:8px;height:8px;border-radius:999px;margin-left:7px}"
    },
    {
      "name": "Result Stamp",
      "kind": "custom",
      "refersTo": "stamp-aprovada",
      "description": "Square stamp for the result: filled pen for aprovada, outlined Carbon for chumbada.",
      "html": "<span class=\"ds-stamp ds-stamp-ok\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\"><path fill=\"currentColor\" d=\"M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z\"/></svg>Aprovada</span> <span class=\"ds-stamp ds-stamp-no\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\"><path fill=\"currentColor\" d=\"M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z\"/></svg>Chumbada</span>",
      "css": ".ds-stamp{display:inline-flex;gap:4px;padding:3px 8px 3px 6px;border:1.5px solid;border-radius:2px;font-family:'Public Sans',system-ui,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.6px;text-transform:uppercase}.ds-stamp-ok{background:#120A8F;border-color:#120A8F;color:#FFFFFF}.ds-stamp-no{background:transparent;border-color:#232323;color:#232323}"
    },
    {
      "name": "X Box",
      "kind": "custom",
      "refersTo": "x-box",
      "description": "The square ballot box with the ✕ stroked in by the pen (two 210ms strokes, 80ms beat).",
      "html": "<span class=\"ds-xb\"><svg viewBox=\"0 0 22 22\" width=\"22\" height=\"22\"><path class=\"ds-s1\" d=\"M6 6L16 16\" /><path class=\"ds-s2\" d=\"M16 6L6 16\"/></svg></span>",
      "css": ".ds-xb{display:inline-flex;width:22px;height:22px;border:1.5px solid #232323;border-radius:2px;background:#FFFFFF;box-sizing:border-box;align-items:center;justify-content:center}.ds-xb svg{width:19px;height:19px}.ds-xb path{stroke:#120A8F;stroke-width:2.6;stroke-linecap:round;stroke-dasharray:15;stroke-dashoffset:15;animation:ds-draw 210ms cubic-bezier(0.33,1,0.68,1) forwards}.ds-xb .ds-s2{animation-delay:290ms}@keyframes ds-draw{to{stroke-dashoffset:0}}@media (prefers-reduced-motion:reduce){.ds-xb path{animation:none;stroke-dashoffset:0}}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The pen-coloured action: ultramarine fill, near-square, 48px.",
      "html": "<button class=\"ds-btn-primary\">Tentar de novo</button>",
      "css": ".ds-btn-primary{min-height:48px;padding:0 20px;background:#120A8F;color:#FFFFFF;border:1.5px solid #120A8F;border-radius:3px;font-family:'Public Sans',system-ui,sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:border-color 200ms cubic-bezier(0.16,1,0.3,1),background-color 200ms cubic-bezier(0.16,1,0.3,1);}.ds-btn-primary:active{opacity:0.8}.ds-btn-primary:focus-visible{outline:2px solid #449DD1;outline-offset:2px}.ds-btn-primary:disabled{opacity:0.45}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "White paper with an ink border; hover shades the paper and turns the border to pen.",
      "html": "<button class=\"ds-btn-secondary\">Ver todas</button>",
      "css": ".ds-btn-secondary{min-height:48px;padding:0 20px;background:#FFFFFF;color:#232323;border:1.5px solid #232323;border-radius:3px;font-family:'Public Sans',system-ui,sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:border-color 200ms cubic-bezier(0.16,1,0.3,1),background-color 200ms cubic-bezier(0.16,1,0.3,1);}.ds-btn-secondary:hover{background:#EEF0F3;border-color:#120A8F}.ds-btn-secondary:active{opacity:0.8}.ds-btn-secondary:focus-visible{outline:2px solid #449DD1;outline-offset:2px}"
    },
    {
      "name": "Ballot Option",
      "kind": "chip",
      "refersTo": "ballot-option",
      "description": "Filters as ballot options: a small ✕ box plus label; selected gets the pen frame and wash.",
      "html": "<button class=\"ds-opt ds-opt-on\"><span class=\"ds-ob\"><svg viewBox=\"0 0 14 14\" width=\"14\" height=\"14\"><path d=\"M4 4L10 10M10 4L4 10\" stroke=\"#120A8F\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg></span>Habitação</button><button class=\"ds-opt\"><span class=\"ds-ob\"></span>Saúde</button>",
      "css": ".ds-opt{display:inline-flex;align-items:center;gap:8px;min-height:36px;padding:0 8px;margin-right:4px;background:transparent;border:1px solid transparent;border-radius:3px;color:#232323;font-family:'Public Sans',system-ui,sans-serif;font-size:14px;font-weight:600;cursor:pointer;transition:border-color 200ms cubic-bezier(0.16,1,0.3,1),background-color 200ms cubic-bezier(0.16,1,0.3,1);}.ds-opt:hover{background:#EEF0F3}.ds-opt-on,.ds-opt-on:hover{background:#E8E7F4;border-color:#120A8F;color:#120A8F}.ds-opt:focus-visible{outline:2px solid #449DD1;outline-offset:2px}.ds-ob{display:inline-flex;width:14px;height:14px;border:1.25px solid #232323;border-radius:2px;box-sizing:border-box;align-items:center;justify-content:center;overflow:hidden;background:#FFFFFF}.ds-ob svg{width:12px;height:12px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "The one search field: white paper, ink border, pen caret, Blue Bell focus ring.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\"><path fill=\"#585D64\" d=\"M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z\"/></svg><input placeholder=\"Procurar deputado\" /></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;min-height:44px;padding:0 12px;background:#FFFFFF;border:1.5px solid #232323;border-radius:3px;max-width:360px}.ds-search:focus-within{outline:2px solid #449DD1;outline-offset:2px}.ds-search input{flex:1;border:0;outline:0;background:transparent;font-family:'Public Sans',system-ui,sans-serif;font-size:16px;color:#232323;caret-color:#120A8F}.ds-search input::placeholder{color:#585D64}"
    },
    {
      "name": "Top Bar with Desktop Nav",
      "kind": "nav",
      "refersTo": "top-bar",
      "description": "56px paper bar on a 1.5px ink rule: logo and wordmark, text nav with a Blue Bell underline on the active item.",
      "html": "<nav class=\"ds-top\"><span class=\"ds-word\"><b>Voto</b>Claro</span><a class=\"ds-nav ds-nav-on\" href=\"#\" aria-current=\"page\">Votações</a><a class=\"ds-nav\" href=\"#\">Deputados</a><a class=\"ds-nav\" href=\"#\">Perguntar</a><a class=\"ds-nav\" href=\"#\">Comparar</a></nav>",
      "css": ".ds-top{display:flex;align-items:stretch;gap:20px;height:56px;padding:0 16px;background:#FFFFFF;border-bottom:1.5px solid #232323;font-family:'Public Sans',system-ui,sans-serif;}.ds-word{display:flex;align-items:center;margin-right:4px;font-size:20px;font-weight:400;letter-spacing:-0.3px;color:#232323}.ds-word b{font-weight:800}.ds-nav{display:flex;align-items:center;padding-top:3px;border-bottom:3px solid transparent;font-size:15px;font-weight:500;color:#585D64;text-decoration:none;transition:border-color 200ms cubic-bezier(0.16,1,0.3,1),background-color 200ms cubic-bezier(0.16,1,0.3,1);}.ds-nav:hover{color:#232323}.ds-nav-on{color:#232323;font-weight:600;border-bottom-color:#449DD1}.ds-nav:focus-visible{outline:2px solid #449DD1;outline-offset:2px}"
    },
    {
      "name": "Section Heading",
      "kind": "custom",
      "refersTo": "section-head",
      "description": "Printed-ballot heading: tracked caps on a 1.5px ink rule, optional note at right. The heading itself, never a label above one.",
      "html": "<div class=\"ds-sec\"><h2>28 Out</h2><span>6 votações</span></div>",
      "css": ".ds-sec{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:8px;border-bottom:1.5px solid #232323;font-family:'Public Sans',system-ui,sans-serif;}.ds-sec h2{margin:0;font-size:14px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:#232323}.ds-sec span{font-size:13px;color:#585D64}"
    }
  ],
  "narrative": {
    "northStar": "The Ballot Slip",
    "overview": "Every vote in VotoClaro is drawn as the paper every Portuguese voter has held: a white slip with square corners, ruled in ink, with a row per option, a square box at the start of each row, and a ✕ made with a pen. The visitor reads a vote the way they would read a boletim de voto, without needing to know parliamentary procedure. The interface is that paper and nothing else. Hierarchy comes from ink weight, rule weight and type size, never from shadows, gradients or coloured tiles.\n\nThe world is bright, flat and quiet, so the votes carry the colour. Bright Snow is the table the slips lie on; white slips sit on it, ruled in Carbon. Dark Ultramarine is the pen: it marks the ✕, the links, the primary action and the \"aprovada\" stamp. Blue Bell is the \"you are here\" marker: the active tab, the focus ring, the text selection, and the logo. Vote colours (favor, contra, abstenção) live only inside data: the tally numbers and the 230-seat bar. Party colours live only in the small dots beside party acronyms.\n\nThe one authored motion is the pen: the ✕ is stroked into its box in two strokes when a slip comes into view and on the vote detail. Every other state change is a single 200ms ease-out. It rejects the civic-tech card stack: pill chips, stat tiles, coloured edge stripes and soft shadows.",
    "keyCharacteristics": [
      "White slips with near-square corners (3px) and 1.5px Carbon ink frames on a Bright Snow ground.",
      "Hairline dividers between ballot rows; a 1.5px ink rule under section and day headings.",
      "Dark Ultramarine as the single pen colour; Blue Bell only for location and focus.",
      "One family, Public Sans, with tabular figures for every count.",
      "The ✕ drawn into a square box is the signature mark and the only authored animation.",
      "No shadows anywhere. Depth is paper on table, drawn with rules."
    ],
    "rules": [
      {
        "name": "The One Pen Rule",
        "body": "Dark Ultramarine is the only ink that marks: the ✕, links, the primary action, the \"aprovada\" stamp. Nothing decorative is ever ultramarine.",
        "section": "colors"
      },
      {
        "name": "The Marker Rule",
        "body": "Blue Bell says only \"you are here\": active tab, focus ring, selection, logo. In light mode it is never text (2.85:1 on Bright Snow).",
        "section": "colors"
      },
      {
        "name": "The Data-Only Colour Rule",
        "body": "Vote colours appear only in tallies and the seat bar; party colours only as dots beside acronyms. Never text on a party colour, never a party colour as a fill, edge stripe or background.",
        "section": "colors"
      },
      {
        "name": "The Heading-Is-The-Heading Rule",
        "body": "Tracked caps exist only as the heading itself (section heads, day heads), as ballot column headers, and inside the stamp. Nothing ever sits above a heading as a label: no eyebrow, no kicker.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every count is set in tabular figures so tallies line up across slips.",
        "section": "typography"
      },
      {
        "name": "The Paper-Not-Plastic Rule",
        "body": "No box-shadow, no glow, no blur. If something needs separating, draw a rule.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw every vote as a slip: white paper, 3px corners, 1.5px Carbon frame, hairline rows, square ✕ boxes.",
      "Do keep Dark Ultramarine (#120A8F) for the pen only: ✕ marks, links, primary action, \"aprovada\" stamp.",
      "Do keep Blue Bell (#449DD1) for \"you are here\": active tab, focus ring, selection, logo; switch the pen to Blue Bell in dark mode.",
      "Do pair every result and position with a word and an icon or mark, never colour alone.",
      "Do use one 200ms ease-out (cubic-bezier(0.16, 1, 0.3, 1)) for every state change, and keep the two-stroke ✕ (210ms + 80ms + 210ms) as the only authored motion.",
      "Do show the 230-seat bar at a fixed scale and without animation.",
      "Do set counts in tabular figures.",
      "Do use the logo image from votoclaro/assets/brand/ as supplied."
    ],
    "donts": [
      "Don't add shadows, glows or blur; separate with rules.",
      "Don't put a label, eyebrow or kicker above a heading; tracked caps are only the heading itself, ballot column headers and the stamp.",
      "Don't use pill-shaped chips, stat tiles or coloured edge stripes; filters are ballot options with ✕ boxes.",
      "Don't set Blue Bell as text in light mode, or Dark Ultramarine on Carbon in dark mode.",
      "Don't put text on a party colour or use a party colour as a fill or background; give no party more colour weight, size or position than its data warrants.",
      "Don't redraw, recolour or restyle the logo.",
      "Don't use vote colours outside tallies, the seat bar and the position indicator."
    ]
  }
}